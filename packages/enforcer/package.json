{
  "name": "@dsc/enforcer",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/vite.ts --format esm --dts --sourcemap --clean",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@dsc/compiler": "workspace:*",
    "postcss": "^8.5.29",
    "postcss-value-parser": "^4.2.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "vite": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "vite": "^7.1.7",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4",
    "@types/node": "^22.18.6"
  },
  "engines": {
    "node": ">=22"
  }
}

{
  "name": "@dsc/hospital-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ds inspect --mode warn && vite",
    "dev:strict": "ds inspect --mode strict && vite --mode strict",
    "build": "vite build",
    "check": "ds inspect --mode strict --fail-on-warnings",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@dsc/compiler": "workspace:*",
    "@dsc/enforcer": "workspace:*",
    "@dsc/cli": "workspace:*",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}

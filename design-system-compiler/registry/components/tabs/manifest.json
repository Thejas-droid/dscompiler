{
  "name": "tabs",
  "version": "1.1.0",
  "description": "Keyboard-navigable tab set.",
  "files": [
    "tabs.tsx",
    "tabs.css"
  ],
  "dependencies": [
    "@dsc/primitives@^0.1.0"
  ],
  "registryDependencies": [],
  "tokens": [
    "color.border.default",
    "color.text.secondary",
    "color.text.brand",
    "color.border.focus"
  ],
  "requires": {
    "react": ">=18.3",
    "compiler": ">=0.1.0"
  },
  "accessibility": {
    "keyboard": [
      "ArrowLeft / ArrowRight moves tabs",
      "Home / End moves to first / last tab"

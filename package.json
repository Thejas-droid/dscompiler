{
  "name": "design-system-compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "check": "node ./packages/cli/dist/index.js --cwd . check",
    "ds": "node ./packages/cli/dist/index.js --cwd .",
    "dev": "pnpm --filter @dsc/docs dev",
    "docs": "pnpm --filter @dsc/docs dev",
    "visual": "pnpm --filter @dsc/visual-tests test",
    "test:docs": "pnpm --filter @dsc/visual-tests test:docs",
    "benchmark": "node --loader ts-node/esm scripts/benchmark.ts",
    "clean": "find packages apps -type d -name dist -prune -exec rm -rf {} +",
    "demo": "pnpm --filter @dsc/hospital-demo dev",
    "demo:strict": "pnpm --filter @dsc/hospital-demo dev:strict",
    "demo:check": "pnpm --filter @dsc/hospital-demo check",
    "demo:break": "node scripts/demo-violation.mjs break",
    "demo:fix": "node scripts/demo-violation.mjs fix",
    "test:enforcement": "pnpm --filter @dsc/enforcer test",
    "test:integration": "node scripts/test-enforcement.mjs",
    "package:local": "node scripts/package-local.mjs",
    "test:demo": "node scripts/test-demo-ui.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@changesets/cli": "^2.29.7",
    "@playwright/test": "1.55.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "tsup": "^8.5.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "ts-node": "^10.9.2"
  }
}

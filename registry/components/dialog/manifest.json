  "files": [
    "dialog.tsx",
    "dialog.css"
  ],
  "dependencies": [
    "@dsc/primitives@^0.1.0"
  ],
  "registryDependencies": [
    "button"
  ],
  "tokens": [
    "color.background.surface",
    "color.text.primary",
    "color.text.secondary",
    "shadow.overlay",
    "radius.panel"
  ],
  "requires": {
    "react": ">=18.3",
    "compiler": ">=0.1.0"
